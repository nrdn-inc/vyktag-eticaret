# Veritabanı (Hostinger MySQL)
DATABASE_URL="mysql://kullanici:sifre@localhost:3306/vyktag"

# Node.js işlemi başına açılacak azami veritabanı bağlantısı (varsayılan: 5).
# Hostinger hesap limitleri: aynı anda en fazla 75 bağlantı, saatte en fazla 500 yeni
# bağlantı. Uygulama birden çok işlemle çalışabildiği için işlem başına payı küçük
# tutuyoruz. Havuz ayarlarının gerekçesi için bkz. src/lib/prisma-pool.ts
DATABASE_CONNECTION_LIMIT="5"

# iyzico
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"   # canlı: https://api.iyzipay.com

# Uygulama
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# On-demand ISR yenileme endpoint'i (/api/yenile) için gizli anahtar.
# Seed/katalog güncellemesi sonrası bu anahtarla sayfaları anında yenilersiniz.
REVALIDATE_SECRET=""

# Admin paneli (/admin/*), müşteri hesabı (/hesap/*) oturumlarını ve e-posta doğrulama
# bağlantılarını imzalamak için rastgele bir anahtar.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# SMTP (Hostinger e-posta kutusu, ör. info@vyktag.com.tr) — kayıt doğrulama e-postaları için.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="VYKTag <info@vyktag.com.tr>"
